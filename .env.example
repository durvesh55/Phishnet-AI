# Copy to .env and fill in. NEVER commit .env.
FLASK_ENV=development          # development | production | testing
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_hex(32))"

# MySQL 8.x (required)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=phishnet
MYSQL_USER=phishnet
MYSQL_PASSWORD=change-me
# Used only by the test-suite (a SEPARATE database that tests may wipe!)
TEST_MYSQL_DATABASE=phishnet_test

# Redis (rate limiting + caching). Leave empty in dev to use in-process memory.
REDIS_URL=

# Mail. MAIL_BACKEND = console (dev only) | smtp
MAIL_BACKEND=console
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=PhishNet AI <no-reply@example.com>

# App behaviour
BASE_URL=http://localhost:5000
RISK_THRESHOLD_SUSPICIOUS=30
RISK_THRESHOLD_PHISHING=60
MAX_EMAIL_CHARS=50000
DEFAULT_RETENTION_DAYS=0       # 0 = keep until user deletes
